{
  "version": "0.2.0",
  "updated": "2026-11-11",
  "note": "配信先の公式の案内から読み取った決まりだけを載せる。公式で確かめられなかった項目は status=unverified とし、チェックでは「未確認」と表示する。法律の助言ではない。最終判断は各配信先の案内で。",
  "levels": {
    "block": "断られる",
    "warn": "危ない",
    "info": "確認"
  },
  "platforms": {
    "apple_music": {
      "name": "Apple Music",
      "kind": "store"
    },
    "spotify": {
      "name": "Spotify",
      "kind": "store"
    },
    "youtube": {
      "name": "YouTube",
      "kind": "video"
    },
    "tunecore_japan": {
      "name": "TuneCore Japan",
      "kind": "distributor"
    },
    "distrokid": {
      "name": "DistroKid",
      "kind": "distributor"
    }
  },
  "rules": [
    {
      "id": "apple.art.no_urls_logos",
      "platform": "apple_music",
      "field": "artwork",
      "level": "block",
      "status": "verified",
      "check": "artwork_has_text",
      "params": {
        "kinds": [
          "url",
          "logo",
          "qr",
          "release_date",
          "price",
          "social_handle"
        ]
      },
      "rule": "ジャケットに Web アドレス・ロゴ・QRコード・発売日・価格・SNSのアカウント名を入れない",
      "fix": "ジャケットの文字はアーティスト名と曲名だけにする",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "7.3 / 1.2",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.art.quality",
      "platform": "apple_music",
      "field": "artwork",
      "level": "warn",
      "status": "verified",
      "check": "manual",
      "rule": "ジャケットは低画質・ぼやけ・ずれ・回転のある画像にしない。AIで加工した場合も文字が崩れていないこと",
      "fix": "元の大きさの画像を使い、AIで作った文字の崩れを直す",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "7.2 / 7.20",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.art.accuracy",
      "platform": "apple_music",
      "field": "artwork",
      "level": "warn",
      "status": "verified",
      "check": "manual",
      "rule": "使い回しのテンプレートや作品と合わないジャケットにしない",
      "fix": "その曲のためのジャケットを使う",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "7.1",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.artist.generic",
      "platform": "apple_music",
      "field": "artist",
      "level": "block",
      "status": "verified",
      "check": "artist_generic",
      "params": {
        "words": [
          "white noise",
          "yoga",
          "music for dogs",
          "lo-fi",
          "lofi",
          "relaxing music",
          "sleep music"
        ]
      },
      "rule": "White Noise・Yoga・Lo-Fi のような一般的な言葉をアーティスト名にしない",
      "fix": "固有のアーティスト名にする",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "2.2",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.artist.one_name",
      "platform": "apple_music",
      "field": "artist",
      "level": "warn",
      "status": "verified",
      "check": "artist_compound",
      "params": {
        "separators": [
          ",",
          "&",
          " x ",
          " X ",
          "、",
          "/"
        ]
      },
      "rule": "アーティスト欄1つに名前は1つだけ",
      "fix": "参加者は別の欄(Featuring/With)に分ける",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "2.3",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.artist.non_performer",
      "platform": "apple_music",
      "field": "artist",
      "level": "block",
      "status": "verified",
      "check": "artist_is_tool",
      "params": {
        "tools": [
          "suno",
          "udio",
          "sunoai",
          "suno ai",
          "chatgpt",
          "openai",
          "stable audio",
          "aiva",
          "boomy",
          "mubert",
          "soundraw"
        ]
      },
      "rule": "演奏していない者(会社・スタジオ・制作者)を主アーティストや Featuring にしない。AIの道具の名前も演奏者ではない",
      "fix": "アーティスト欄から道具の名前を削る。使った道具は制作記録に書く",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "2.6 / 2.14 / 2.16",
      "checked": "2026-11-11",
      "basis": "Apple の案内は会社・スタジオ・演奏しない人を主アーティストにしないと書く。AIの道具名を名指しした記載は無いため、道具名をこの決まりに当てはめたのは NEXUS の読み方"
    },
    {
      "id": "apple.title.feat",
      "platform": "apple_music",
      "field": "title",
      "level": "warn",
      "status": "verified",
      "check": "title_feat_format",
      "rule": "参加者の表記は小文字の英語「feat.」で、かっこの中に書く。featuring・Feat・w/ は使わない",
      "fix": "例: Song Name (feat. Artist)",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "2.13",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.title.extra_words",
      "platform": "apple_music",
      "field": "title",
      "level": "block",
      "status": "verified",
      "check": "title_extra_words",
      "params": {
        "words": [
          "exclusive",
          "limited edition",
          "album version",
          "original mix",
          "official music video",
          "(explicit)",
          "(clean)",
          "(edited)"
        ]
      },
      "rule": "曲名に Exclusive・Limited Edition・Album Version・Original Mix・(Explicit) などを入れない。検索語やアーティスト情報も入れない",
      "fix": "曲名だけにする",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "3.2 / 6.1 / 6.2",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.title.case",
      "platform": "apple_music",
      "field": "title",
      "level": "warn",
      "status": "verified",
      "check": "title_case_en",
      "rule": "英語の曲名は全部大文字・全部小文字・ばらばらにしない(タイトルケースにする)",
      "fix": "例: Walking In The Rain → Walking in the Rain",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "3.20 / 3.21",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.lyrics.punct",
      "platform": "apple_music",
      "field": "lyrics",
      "level": "info",
      "status": "verified",
      "check": "lyrics_line_end_punct",
      "rule": "歌詞の行の終わりに句点やカンマを付けない。歌詞は音と合っていること",
      "fix": "行の終わりの「.」「,」を消す",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "Lyrics Guidelines",
      "checked": "2026-11-11"
    },
    {
      "id": "spotify.voice.impersonation",
      "platform": "spotify",
      "field": "vocals",
      "level": "block",
      "status": "verified",
      "check": "voice_impersonation",
      "rule": "実在の歌手の声に似せた歌(AIの声の複製を含む)は、その歌手の許可があるときだけ",
      "fix": "実在の歌手の名前を声の指定に使わない。許可が無ければ出さない",
      "source": "https://newsroom.spotify.com/2025-09-25/spotify-strengthens-ai-protections/",
      "section": "Impersonation",
      "checked": "2026-11-11"
    },
    {
      "id": "spotify.spam",
      "platform": "spotify",
      "field": "release",
      "level": "warn",
      "status": "verified",
      "check": "spam_pattern",
      "rule": "大量の投稿・重複・検索語のごまかし・わざと短い曲は、迷惑行為として印を付けられ、おすすめに出なくなる",
      "fix": "同じ曲の出し直しや短すぎる曲の量産をしない",
      "source": "https://newsroom.spotify.com/2025-09-25/spotify-strengthens-ai-protections/",
      "section": "Spam filter",
      "checked": "2026-11-11",
      "basis": "数のしきい値(何曲・何秒)は公式に書かれていない"
    },
    {
      "id": "spotify.ai_credit",
      "platform": "spotify",
      "field": "credits",
      "level": "info",
      "status": "verified",
      "check": "ai_disclosure",
      "rule": "AIを使った部分(歌・楽器・仕上げ)は DDEX の形でクレジットに示せる。示しても順位は下げないと書かれている",
      "fix": "配信会社の入力欄にAIを使った部分を書く(欄があれば)",
      "source": "https://newsroom.spotify.com/2025-09-25/spotify-strengthens-ai-protections/",
      "section": "AI disclosures",
      "checked": "2026-11-11"
    },
    {
      "id": "youtube.synthetic.disclose",
      "platform": "youtube",
      "field": "upload",
      "level": "warn",
      "status": "verified",
      "check": "ai_disclosure",
      "rule": "本物らしく見えるAIの生成・加工は申告が要る。動画の中心がAIの音楽のときも対象。申告だけで視聴者や収益は減らない",
      "fix": "投稿時の「改変または合成されたコンテンツ」で「はい」を選ぶ",
      "source": "https://support.google.com/youtube/answer/14328491",
      "section": "Disclosure",
      "checked": "2026-11-11"
    },
    {
      "id": "youtube.monetization.mass",
      "platform": "youtube",
      "field": "release",
      "level": "warn",
      "status": "verified",
      "check": "spam_pattern",
      "rule": "ありふれた型で量産したようなAIの作品は収益化の対象外(2025-07-15 に「inauthentic content」と改名)",
      "fix": "1曲ずつ違う動画・説明にする",
      "source": "https://support.google.com/youtube/answer/1311392",
      "section": "Inauthentic content",
      "checked": "2026-11-11"
    },
    {
      "id": "tunecore.art.spec",
      "platform": "tunecore_japan",
      "field": "artwork",
      "level": "block",
      "status": "verified",
      "check": "artwork_size",
      "params": {
        "min_px": 3000,
        "square": true,
        "formats": [
          "jpg",
          "jpeg",
          "png"
        ]
      },
      "rule": "ジャケットは正方形・縦横3,000px以上・JPGかPNG",
      "fix": "3000×3000px のJPGかPNGで書き出す",
      "source": "https://www.tunecore.co.jp/guide/articles/music-release-cover-art",
      "section": "ジャケット",
      "checked": "2026-11-11"
    },
    {
      "id": "tunecore.art.extra_info",
      "platform": "tunecore_japan",
      "field": "artwork",
      "level": "warn",
      "status": "verified",
      "check": "artwork_has_text",
      "params": {
        "kinds": [
          "url",
          "logo",
          "qr",
          "release_date",
          "price",
          "social_handle",
          "other"
        ]
      },
      "rule": "ジャケットにアーティスト名・作品名以外の関係の無い情報を入れない。他人のロゴや画像を許可なく使わない",
      "fix": "ジャケットの文字はアーティスト名と曲名だけにする",
      "source": "https://www.tunecore.co.jp/guide/articles/music-release-cover-art",
      "section": "ジャケット",
      "checked": "2026-11-11"
    },
    {
      "id": "tunecore.rights",
      "platform": "tunecore_japan",
      "field": "rights",
      "level": "warn",
      "status": "verified",
      "check": "rights_plan",
      "rule": "登録する人が必要な権利をすべて持ち、他人の権利を侵さないこと(利用規約 第5条)",
      "fix": "使ったAIの道具のプランが商用利用を認めているか、その道具の規約で確かめる",
      "source": "https://www.tunecore.co.jp/terms/person",
      "section": "第5条(2025-12-22 改定版)",
      "checked": "2026-11-11",
      "basis": "規約にAIを名指しした条文は読めた範囲で見つからない。無料プランの扱いは各AIの道具の規約による"
    },
    {
      "id": "tunecore.ai_policy",
      "platform": "tunecore_japan",
      "field": "ai",
      "level": "info",
      "status": "unverified",
      "check": "manual",
      "rule": "生成AIの曲の扱い(公式の配信規程)は今回読めなかった",
      "fix": "TuneCore Japan のヘルプの「配信規程」を出す前に確かめる",
      "source": "https://www.tunecore.co.jp/terms/person",
      "section": "配信規程(未読)",
      "checked": "2026-11-11"
    },
    {
      "id": "distrokid.ai_policy",
      "platform": "distrokid",
      "field": "ai",
      "level": "info",
      "status": "unverified",
      "check": "manual",
      "rule": "DistroKid のAIの曲・ジャケット・アーティスト名の決まりは、公式のページで今回確かめられなかった",
      "fix": "DistroKid のヘルプで確かめてから出す",
      "source": "https://support.distrokid.com/hc/en-us",
      "section": "未確認",
      "checked": "2026-11-11"
    },
    {
      "id": "apple.meta.no_side_by_side",
      "platform": "apple_music",
      "field": "title",
      "level": "warn",
      "status": "verified",
      "check": "side_by_side_translation",
      "rule": "曲名・アーティスト名に訳を横に並べて書かない(例: 雨の街 (Ame no Machi))。訳や読みは配信会社の別の欄に入れる",
      "fix": "欄には元の言葉だけを書く。英語の表記は配信会社の「翻訳・読み」の欄に入れる",
      "source": "https://help.apple.com/itc/musicstyleguide/en.lproj/static.html",
      "section": "1.9 / 2.1",
      "checked": "2026-11-11"
    },
    {
      "id": "spotify.meta.no_side_by_side",
      "platform": "spotify",
      "field": "artist",
      "level": "warn",
      "status": "verified",
      "check": "side_by_side_translation",
      "rule": "アーティスト名に別名や訳を同じ欄に並べない(例: 玉置浩二 (Kōji Tamaki) は誤り)。日本語の名前は元の順(姓→名)で書く",
      "fix": "欄には元の名前だけを書き、訳は別に出す。名前の順は入れかえない",
      "source": "https://providersupport.spotify.com/article/spotify-metadata-style-guide-msg",
      "section": "1.4 / 1.6",
      "checked": "2026-11-11"
    },
    {
      "id": "spotify.title.no_feat",
      "platform": "spotify",
      "field": "title",
      "level": "warn",
      "status": "verified",
      "check": "title_has_feat",
      "rule": "参加者は曲名に書かず、参加者の欄に分けて入れる(Apple Music の「(feat. 名前)」とは扱いが逆)",
      "fix": "曲名から「feat. 名前」を消し、配信会社の参加者(Featuring)の欄に名前を入れる",
      "source": "https://providersupport.spotify.com/article/spotify-metadata-style-guide-msg",
      "section": "5.1 / 5.3",
      "checked": "2026-11-11",
      "basis": "Spotify の案内は曲名に参加者を書いた例を誤りとしている。配信会社によっては自動で曲名に付けるため、入力の欄で分けるという読み方"
    }
  ]
}
